NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Números de vendas (Fase 2) ──
# mock = dados de exemplo; sheets = planilha do Google. Vazio = usa "sheets" se houver credenciais.
SALES_SOURCE=mock
# Service account com acesso de leitura à planilha (compartilhe a planilha com este e-mail)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada do JSON da service account, entre aspas, com \n literais
GOOGLE_PRIVATE_KEY=
# ID na URL: docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
# Segredo do cron (Vercel envia como Authorization: Bearer ...). Gere com: openssl rand -hex 32
CRON_SECRET=

# Só para testes locais (npm run test:sales): caminho de uma cópia da planilha .xlsx. Nunca versionar.
SALES_FIXTURE_XLSX=
